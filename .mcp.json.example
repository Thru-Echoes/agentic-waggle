{
  "_comment": [
    "Sample MCP client config for connecting to Waggle's two MCP servers.",
    "Copy to .mcp.json (or your client's equivalent — Claude Desktop:",
    "~/Library/Application Support/Claude/claude_desktop_config.json; Codex:",
    "~/.codex/mcp.json; Cursor: project .cursor/mcp.json) and fill in the",
    "env vars. Both servers speak stdio.",
    "",
    "Prereqs: `make up && make migrate && make seed` so the DB is populated.",
    "Then point DATABASE_URL at the host-mapped Postgres (localhost:5433)."
  ],
  "mcpServers": {
    "waggle-sales-copilot": {
      "command": "python",
      "args": ["-m", "mcp_servers.sales_copilot_server"],
      "cwd": "/absolute/path/to/agentic-mcp-crm/waggle",
      "env": {
        "DATABASE_URL": "postgresql://agentic_mcp_crm:agentic_mcp_crm@localhost:5433/agentic_mcp_crm",
        "OPENAI_API_KEY": "sk-...",
        "LLM_PROVIDER": "openai"
      }
    },
    "waggle-customer-reports": {
      "command": "python",
      "args": ["-m", "mcp_servers.customer_reports_server"],
      "cwd": "/absolute/path/to/agentic-mcp-crm/waggle",
      "env": {
        "DATABASE_URL": "postgresql://agentic_mcp_crm:agentic_mcp_crm@localhost:5433/agentic_mcp_crm",
        "OPENAI_API_KEY": "sk-..."
      }
    }
  }
}
