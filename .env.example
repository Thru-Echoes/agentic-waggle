# Copy to .env and set at least one LLM key. The app fails loudly at startup
# (LLMConfigurationError) if the selected provider's key is missing AND no
# fallback key is set. There is no canned/offline mode — see fail-loud.md.
#
# Default provider is OpenAI (gpt-6.1-terra; see app/config.py for the
# per-stage fields and docs/benchmarks/ for the numbers). To switch to Claude, set
# LLM_PROVIDER=anthropic and provide ANTHROPIC_API_KEY.

# Primary (default provider)
OPENAI_API_KEY=

# Optional fallback, or primary when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Provider selection: "openai" (default) or "anthropic"
# LLM_PROVIDER=anthropic

# HTTP Basic auth (production gate). If BOTH are set, every request
# (except /health, /ready, /static/*) requires basic-auth credentials
# matching this pair. Leave blank for local dev — middleware no-ops.
# Set via Fly secrets in production.
# WAGGLE_USER=demo
# WAGGLE_PASS=

# Visitor cookie signing key (scopes copilot conversations per browser).
# Unset: a random per-process key, so visitors are forgotten on restart.
# Set a long random value in production (fly secrets set WAGGLE_SECRET_KEY=…).
# WAGGLE_SECRET_KEY=

# Demo-only: print the Basic-auth credentials on the HTML 401 page. The
# portfolio demo publishes them on purpose; never set this for a real deploy.
# WAGGLE_DEMO_CREDENTIALS_PUBLIC=1
# WAGGLE_PORTFOLIO_URL=https://thru-echoes.github.io/waggle

# LLM spend guards on the model-backed routes (/copilot/turns, /inbox/extract,
# /api/agent/extract). Per client address per minute, and per UTC day overall.
# 0 disables a check. Each request is 2-10 model calls.
# WAGGLE_LLM_RATE_PER_MINUTE=10
# WAGGLE_LLM_DAILY_BUDGET=500

# Sentence-transformers model cache. First run downloads ~80 MB.
# Defaults to ~/.cache/huggingface if unset; change to a volume-mounted path
# for reproducible containers.
# HF_HOME=/models
