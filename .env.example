# Copy to .env and set at least one LLM key. The app fails loudly at startup
# (LLMConfigurationError) if the selected provider's key is missing AND no
# fallback key is set. There is no canned/offline mode — see fail-loud.md.
#
# Default provider is OpenAI (gpt-5.4-mini). To switch to Claude, set
# LLM_PROVIDER=anthropic and provide ANTHROPIC_API_KEY.

# Preferred for the demo (Claude)
ANTHROPIC_API_KEY=

# Optional fallback (or primary if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Provider selection: "openai" (default) or "anthropic"
# LLM_PROVIDER=anthropic

# HTTP Basic auth (production gate). If BOTH are set, every request
# (except /health, /ready, /static/*) requires basic-auth credentials
# matching this pair. Leave blank for local dev — middleware no-ops.
# Set via Fly secrets in production.
# WAGGLE_USER=demo
# WAGGLE_PASS=

# Sentence-transformers model cache. First run downloads ~80 MB.
# Defaults to ~/.cache/huggingface if unset; change to a volume-mounted path
# for reproducible containers.
# HF_HOME=/models
